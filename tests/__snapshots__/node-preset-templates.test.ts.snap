exports[`node preset templates > renders eslint.config.mjs 1`] = `
"import js from '@eslint/js';
import { defineConfig, globalIgnores } from 'eslint/config';
import eslintConfigPrettier from 'eslint-config-prettier';
import pluginAutofix from 'eslint-plugin-autofix';
import pluginImportX from 'eslint-plugin-import-x';
import pluginPreferArrowFunctions from 'eslint-plugin-prefer-arrow-functions';
import pluginPrettier from 'eslint-plugin-prettier';
import globals from 'globals';
import tseslint from 'typescript-eslint';

const { JAVASCRIPT_FILES, TYPESCRIPT_FILES, CODE_FILES } = (() => {
	const TEST_FOLDERS = 'test{,s},__test{s,}__,spec{,s},e2e';
	const SOURCE_FOLDERS = \`src,lib{,s},bin{,s},script{,s},tool{,s},config{,s},type{,s},\${TEST_FOLDERS}\`;

	const JAVASCRIPT_EXTENSIONS = 'cjs,mjs,js,jsx';
	const TYPESCRIPT_EXTENSIONS = 'cts,mts,ts,tsx';
	const CODE_EXTENSIONS = \`\${JAVASCRIPT_EXTENSIONS},\${TYPESCRIPT_EXTENSIONS}\`;

	const JAVASCRIPT_FILES = [\`{\${SOURCE_FOLDERS}}/**/*.{\${JAVASCRIPT_EXTENSIONS}}\`, \`*.{\${JAVASCRIPT_EXTENSIONS}}\`];
	const TYPESCRIPT_FILES = [\`{\${SOURCE_FOLDERS}}/**/*.{\${TYPESCRIPT_EXTENSIONS}}\`, \`*.{\${TYPESCRIPT_EXTENSIONS}}\`];
	const CODE_FILES = [\`{\${SOURCE_FOLDERS}}/**/*.{\${CODE_EXTENSIONS}}\`, \`*.{\${CODE_EXTENSIONS}}\`];

	return {
		JAVASCRIPT_FILES,
		TYPESCRIPT_FILES,
		CODE_FILES
	};
})();

const IGNORED_PATHS = ['dist/**', 'coverage/**', 'node_modules/**'];

const eslintConfig = defineConfig(
	globalIgnores(IGNORED_PATHS),

	{
		files: CODE_FILES,
		extends: [js.configs.recommended, tseslint.configs.recommended],
		languageOptions: {
			ecmaVersion: 'latest',
			sourceType: 'module',
			globals: { ...globals.node }
		}
	},

	// A type-aware rule on a file with no \`projectService\` is a hard error, so JavaScript opts out.
	{
		files: TYPESCRIPT_FILES,
		extends: [tseslint.configs.recommendedTypeChecked],
		languageOptions: {
			parserOptions: {
				projectService: true,
				tsconfigRootDir: import.meta.dirname
			}
		}
	},
	{
		files: JAVASCRIPT_FILES,
		extends: [tseslint.configs.disableTypeChecked]
	},

	{
		files: CODE_FILES,
		settings: {
			'import-x/internal-regex': '^@/'
		},
		plugins: {
			autofix: pluginAutofix,
			'import-x': pluginImportX,
			'prefer-arrow-functions': pluginPreferArrowFunctions,
			prettier: pluginPrettier
		},
		rules: {
			'@typescript-eslint/no-explicit-any': 'off',

			'no-restricted-imports': [
				'error',
				{
					patterns: [
						{
							group: ['../*'],
							message: 'Import through the @/ alias, not a parent-relative path.'
						},
						{
							regex: '^(?:@/|\\\\.{1,2}/).+\\\\.(?:js|ts)$',
							message: 'Import without the file extension.'
						}
					]
				}
			],

			'autofix/eol-last': 'error',
			'autofix/curly': 'error',
			'autofix/no-lonely-if': 'error',
			'autofix/no-else-return': 'error',
			'autofix/object-shorthand': 'error',
			'autofix/object-curly-newline': [
				'error',
				{
					ObjectExpression: {
						multiline: true,
						minProperties: 2,
						consistent: true
					}
				}
			],

			'@typescript-eslint/no-unused-vars': [
				'warn',
				{
					args: 'all',
					argsIgnorePattern: '^_',
					varsIgnorePattern: '^_',
					caughtErrorsIgnorePattern: '^_',
					destructuredArrayIgnorePattern: '^_',
					ignoreRestSiblings: true
				}
			],
			'@typescript-eslint/consistent-type-imports': ['error', { prefer: 'type-imports' }],

			'prefer-arrow-functions/prefer-arrow-functions': ['error', { returnStyle: 'explicit' }],
			'arrow-body-style': ['error', 'always'],

			'import-x/first': 'error',
			'import-x/newline-after-import': 'error',
			'import-x/no-duplicates': 'error',
			'import-x/no-anonymous-default-export': 'error',
			'import-x/order': [
				'error',
				{
					'newlines-between': 'always',
					alphabetize: {
						order: 'asc',
						caseInsensitive: true
					},
					groups: ['builtin', 'external', 'internal', ['parent', 'sibling', 'index'], ['object', 'unknown', 'type']]
				}
			],

			'prettier/prettier': 'error',

			'no-undef': 'off',
			'no-redeclare': 'off',
			'no-import-assign': 'off',
			'padding-line-between-statements': [
				'error',
				{
					blankLine: 'any',
					prev: 'export',
					next: 'export'
				},
				{
					blankLine: 'always',
					prev: ['const', 'let', 'var'],
					next: '*'
				},
				{
					blankLine: 'any',
					prev: ['const', 'let', 'var'],
					next: ['const', 'let', 'var']
				},
				{
					blankLine: 'always',
					prev: '*',
					next: ['function', 'multiline-const', 'multiline-block-like']
				},
				{
					blankLine: 'always',
					prev: ['function', 'multiline-const', 'multiline-block-like'],
					next: '*'
				}
			]
		}
	},

	eslintConfigPrettier
);

export default eslintConfig;
"
`;

exports[`node preset templates > renders package.json per package manager > package.json bun 1`] = `
"{
	"name": "my-app",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.11.0"
	},
	"packageManager": "bun@1.2.3",
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"build": "tsc && tsc-alias --resolve-full-paths",
		"start": "node dist/main.js",
		"typecheck": "tsc --noEmit",
		"lint": "eslint \\"{src,lib{,s},bin{,s},script{,s},tool{,s},config{,s},type{,s},test{,s},__test{s,}__,spec{,s},e2e}/**/*.{cjs,mjs,js,jsx,cts,mts,ts,tsx}\\" \\"*.{cjs,mjs,js,jsx,cts,mts,ts,tsx}\\"",
		"lint:fix": "eslint --fix \\"{src,lib{,s},bin{,s},script{,s},tool{,s},config{,s},type{,s},test{,s},__test{s,}__,spec{,s},e2e}/**/*.{cjs,mjs,js,jsx,cts,mts,ts,tsx}\\" \\"*.{cjs,mjs,js,jsx,cts,mts,ts,tsx}\\"",
		"format": "bun run lint:fix && prettier --write .",
		"prepare": "husky"
	},
	"lint-staged": {
		"{{src,lib{,s},bin{,s},script{,s},tool{,s},config{,s},type{,s},test{,s},__test{s,}__,spec{,s},e2e}/**/*,*}.{cjs,mjs,js,jsx,cts,mts,ts,tsx}": [
			"eslint --fix"
		],
		"**/!(package).{json,md,yml,yaml}": [
			"prettier --write"
		],
		"package.json": [
			"prettier-package-json --write",
			"prettier --write"
		]
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.19.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-autofix": "^2.2.0",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-prefer-arrow-functions": "^3.10.2",
		"eslint-plugin-prettier": "^5.5.7",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-package-json": "^2.8.0",
		"tsc-alias": "^1.9.9",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0"
	}
}
"
`;

