exports[`node preset templates > renders .editorconfig 1`] = `
"root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 2
max_line_length = 120
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_style = space

[*.md]
indent_style = space
trim_trailing_whitespace = false
"
`;

