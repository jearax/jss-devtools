{
	"private": true,
	"name": "nest-app",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build": "nest build",
		"dev": "nest start --watch",
		"format": "npm run lint:fix && prettier --write .",
		"lint": "eslint \"{src,test}/**/*.{cjs,mjs,js,jsx,cts,mts,ts,tsx}\" \"*.{cjs,mjs,js,jsx,cts,mts,ts,tsx}\"",
		"lint:fix": "eslint --fix \"{src,test}/**/*.{cjs,mjs,js,jsx,cts,mts,ts,tsx}\" \"*.{cjs,mjs,js,jsx,cts,mts,ts,tsx}\"",
		"prepare": "husky",
		"start": "nest start",
		"start:debug": "nest start --debug --watch",
		"start:dev": "nest start --watch",
		"start:prod": "node dist/main.js",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"test:debug": "vitest --inspect-brk --no-file-parallelism",
		"test:e2e": "vitest run --config ./vitest.config.e2e.ts",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@nestjs/common": "^12.4.2",
		"@nestjs/config": "^12.1.1",
		"@nestjs/core": "^12.4.2",
		"@nestjs/i18n": "^0.0.3",
		"@nestjs/platform-express": "^12.4.2",
		"@nestjs/terminus": "^12.1.0",
		"nestjs-pino": "^5.3.1",
		"pino": "^10.4.0",
		"pino-http": "^11.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@nestjs/cli": "^12.0.12",
		"@nestjs/schematics": "^12.0.13",
		"@nestjs/testing": "^12.4.2",
		"@types/express": "^5.0.6",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^5.1.0",
		"pino-pretty": "^13.2.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.3.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"lint-staged": {
		"{{src,test}/**/*,*}.{cjs,mjs,js,jsx,cts,mts,ts,tsx}": [
			"eslint --fix"
		],
		"**/!(package).{json,md,yml,yaml}": [
			"prettier --write"
		],
		"package.json": [
			"prettier-package-json --write",
			"prettier --write"
		]
	}
}
