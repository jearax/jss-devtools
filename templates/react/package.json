{
	"private": true,
	"name": "react-app",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build": "tsc -b && vite build",
		"dev": "vite",
		"format": "npm run lint:fix && prettier --write .",
		"lint": "eslint \"src/**/*.{cjs,mjs,js,jsx,cts,mts,ts,tsx}\" \"*.{cjs,mjs,js,jsx,cts,mts,ts,tsx}\"",
		"lint:fix": "eslint --fix \"src/**/*.{cjs,mjs,js,jsx,cts,mts,ts,tsx}\" \"*.{cjs,mjs,js,jsx,cts,mts,ts,tsx}\"",
		"prepare": "husky",
		"preview": "vite preview",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"@openfeature/core": "^1.12.0",
		"@openfeature/react-sdk": "^1.4.1",
		"@openfeature/web-sdk": "^1.10.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-error-boundary": "^6.1.6",
		"react-router": "^8.5.1",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.13",
		"@rolldown/plugin-babel": "^0.3.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"vite": "^8.3.8"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"lint-staged": {
		"{src/**/*,*}.{cjs,mjs,js,jsx,cts,mts,ts,tsx}": [
			"eslint --fix"
		],
		"**/!(package).{json,md,yml,yaml}": [
			"prettier --write"
		],
		"package.json": [
			"prettier-package-json --write",
			"prettier --write"
		]
	}
}
