{
  "name": "@jjuidev/jss-devtools",
  "version": "0.4.0",
  "description": "JavaScript stack dev tools CLI - inspired by Docker's command-tree UX",
  "license": "MIT",
  "homepage": "https://github.com/jearax/jss-devtools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jearax/jss-devtools.git"
  },
  "bugs": {
    "url": "https://github.com/jearax/jss-devtools/issues"
  },
  "type": "module",
  "bin": {
    "jss-devtools": "dist/cli/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "format": "eslint --fix \"{src,tests}/**/*.{js,ts,jsx,tsx}\" \"*.ts\" && prettier --write \"{src,tests}/**/*.{js,ts,jsx,tsx}\" \"*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "husky",
    "release": "pnpm clean && pnpm build && changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "version": "changeset version"
  },
  "sideEffects": false,
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "citty": "^0.2.1",
    "conf": "^15.1.0",
    "consola": "^3.4.2",
    "execa": "^9.6.1",
    "figlet": "^1.10.0",
    "nypm": "^0.6.5",
    "package-manager-detector": "^1.8.0",
    "pathe": "^2.0.3",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^10.0.1",
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.10.5",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-autofix": "^2.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.9.6",
    "prettier-package-json": "^2.1.4",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.3.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "cli",
    "devtools",
    "javascript",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "{src,tests}/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "package.json": [
      "prettier-package-json --write"
    ]
  }
}
