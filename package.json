{
  "name": "@jjuidev/jss-devtools",
  "version": "0.5.8",
  "description": "JavaScript stack dev tools CLI",
  "license": "MIT",
  "homepage": "https://github.com/jearax/jss-devtools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jearax/jss-devtools.git"
  },
  "bugs": {
    "url": "https://github.com/jearax/jss-devtools/issues"
  },
  "type": "module",
  "bin": {
    "jss-devtools": "dist/cli/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "format": "eslint --fix \"{src,tests}/**/*.{js,ts,jsx,tsx}\" \"*.ts\" && prettier --write \"{src,tests}/**/*.{js,ts,jsx,tsx}\" \"*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "husky",
    "release": "pnpm clean && pnpm build && pnpm publish --no-git-checks",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "citty": "^0.2.2",
    "conf": "^15.1.0",
    "consola": "^3.4.2",
    "execa": "^10.0.1",
    "figlet": "^1.11.4",
    "nypm": "^0.6.9",
    "package-manager-detector": "^1.8.0",
    "pathe": "^2.0.3",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/figlet": "^1.7.0",
    "@types/node": "^26.4.0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-autofix": "^2.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-package-json": "^2.8.0",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "cli",
    "devtools",
    "javascript",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "{src,tests}/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "package.json": [
      "prettier-package-json --write"
    ]
  }
}
