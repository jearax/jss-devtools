{
	"private": true,
	"name": "@jjuidev/jss-devtools-site",
	"version": "0.1.0",
	"description": "Landing site cho jss-devtools",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "tsc --noEmit && vite build",
		"dev": "vite",
		"format": "eslint --fix \"{src,vite}/**/*.{ts,tsx,mjs}\" \"*.{ts,mjs}\" && stylelint --fix \"src/**/*.css\"",
		"lint": "eslint \"{src,vite}/**/*.{ts,tsx,mjs}\" \"*.{ts,mjs}\" && stylelint \"src/**/*.css\"",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@fontsource-variable/cascadia-code": "5.3.0",
		"@fontsource/be-vietnam-pro": "5.3.0",
		"@jjuidev/react": "file:vendor/jjuidev-react-0.0.1.tgz",
		"@jjuidev/styles": "file:vendor/jjuidev-styles-0.0.1.tgz",
		"@mantine/hooks": "9.7.4",
		"colorjs.io": "0.7.1",
		"lucide-react": "1.66.0",
		"match-sorter": "8.3.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-router": "8.5.1",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@tailwindcss/vite": "4.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/browser-playwright": "5.0.3",
		"@vitest/eslint-plugin": "1.6.27",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-autofix": "2.2.0",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-prefer-arrow-functions": "3.10.2",
		"eslint-plugin-prettier": "5.5.6",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"globals": "17.12.0",
		"playwright": "1.63.0",
		"prettier": "3.9.10",
		"stylelint": "17.15.0",
		"stylelint-config-css-modules": "4.6.0",
		"stylelint-config-standard": "40.0.0",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vite": "8.3.5",
		"vitest": "5.0.3",
		"vitest-browser-react": "2.3.0"
	}
}
